APP_NAME="OptiLeads Formation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dakar

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local : MySQL 5.7 (MAMP, port 8889). Production : MariaDB 11.4 (LWS, socket UNIX).
# Le serveur LWS est en latin1 : utf8mb4 doit etre impose ici ET a la creation de la base.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=optileads_lms
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Pas de Redis sur l'hebergement mutualise : tout en driver database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Sauvegardes (spatie/laravel-backup) ---
# Dossier de mysqldump (sans le nom du binaire). LWS : souvent /usr/bin. Laisser vide
# si mysqldump est deja dans le PATH. Local MAMP : C:/MAMP/bin/mysql/bin
DB_DUMP_BINARY_PATH=
BACKUP_DISK=backups
BACKUP_NOTIFICATION_EMAIL=admin@opti-leads.com

# --- Notification d'erreur admin (active des que APP_DEBUG=false) ---
# ERROR_NOTIFICATIONS_ENABLED=true
ADMIN_ERROR_EMAIL=admin@opti-leads.com
ERROR_NOTIFICATIONS_THROTTLE=30

# --- Disques de stockage (regle de portabilite n°3 : jamais de chemin en dur) ---
FILESYSTEM_DISK=local
MEDIA_DISK=public
COURSE_ASSETS_DISK=private
CERTIFICATES_DISK=private

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@opti-leads.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Bunny Stream (aucune URL directe : le player recoit une URL signee) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_SECURITY_KEY=
BUNNY_SIGNED_URL_TTL=14400

# --- Regles metier ---
ACCESS_CODE_MAX_ATTEMPTS=5
ACCESS_CODE_DECAY_MINUTES=60
CERTIFICATE_SERIAL_PREFIX=OPT
CONTACT_WHATSAPP_NUMBER=

VITE_APP_NAME="${APP_NAME}"
