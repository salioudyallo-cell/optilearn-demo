# =============================================================================
#  .env de PRODUCTION — OptiLeads Formation (LWS)
# -----------------------------------------------------------------------------
#  Ce fichier est un MODELE. Sur le serveur :
#    cp .env.production.example .env
#    php artisan key:generate            # renseigne APP_KEY automatiquement
#  puis remplacez chaque « <A_COMPLETER ...> » par vos vraies valeurs.
#  Ne transferez JAMAIS ce .env rempli par FTP : il vit sur le serveur.
#  Palier 1 (lancement) : Brevo actif, Bunny vide (aucune leçon vidéo).
#  Palier 2 : renseigner le bloc Bunny et c'est tout.
# =============================================================================

APP_NAME="OptiLeads Formation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://formation.opti-leads.com
APP_TIMEZONE=Africa/Dakar

# =============================================================================
#  MARQUE (marque blanche) — 1 code, N instances
# -----------------------------------------------------------------------------
#  Laisser ce bloc VIDE ou absent = instance « OptiLeads » (valeurs par defaut).
#  Pour une instance a une autre marque : renseigner ces variables, deposer un
#  favicon dans public/images/, puis « php artisan optimize ». Aucun code a toucher.
#
#  Le nom affiche vient de APP_NAME (ci-dessus). Definir BRAND_COLOR_PRIMARY active
#  le re-theme complet (echelle 50..900 generee et injectee au rendu).
#
#  Logo : laisser BRAND_LOGO_IMAGE VIDE = embleme colore + nom en toutes lettres
#  (aucun fichier a produire). Sinon, pointer un fichier de public/.
# =============================================================================
BRAND_SHORT_NAME="OptiLeads"
BRAND_LEGAL_NAME="OptiLeads"
BRAND_TAGLINE="La formation aux métiers du digital pour les équipes et les indépendants en Afrique de l’Ouest."
BRAND_SLOGAN="Plus de leads, plus de croissance."
BRAND_EMAIL="contact@opti-leads.com"
BRAND_CITY="Dakar, Sénégal"
BRAND_REGION="Sénégal · Côte d’Ivoire · Mali"
BRAND_LOGO_IMAGE="images/logo-optileads-mark.png"
BRAND_LOGO_IMAGE_WHITE="images/logo-optileads-mark-white.png"
BRAND_FAVICON="images/logo-optileads.png"
# BRAND_COLOR_PRIMARY=      # ex. #1a56d6 — laisser vide pour garder la charte compilee
# BRAND_COLOR_ACCENT=       # ex. #f97600
# BRAND_COLOR_HIGHLIGHT=    # ex. #ffc101

# --- Exemple d'instance de DEMONSTRATION a marque fictive « Nimba Académie » ---
#  (copier ces valeurs a la place du bloc ci-dessus pour la demo prospects)
#  APP_NAME="Nimba Académie"
#  BRAND_SHORT_NAME="Nimba"
#  BRAND_LEGAL_NAME="Nimba Académie"
#  BRAND_TAGLINE="Montez en compétences, où que vous soyez."
#  BRAND_SLOGAN="Apprendre, progresser, réussir."
#  BRAND_EMAIL="contact@nimba-academie.com"
#  BRAND_CITY="Abidjan · Dakar"
#  BRAND_REGION="Afrique de l’Ouest"
#  BRAND_LOGO_IMAGE=                       # vide -> embleme + nom genere
#  BRAND_LOGO_IMAGE_WHITE=                 # vide -> embleme + nom blanc genere
#  BRAND_FAVICON="images/favicon-nimba.svg"
#  BRAND_COLOR_PRIMARY="#0f6e5c"
#  BRAND_COLOR_ACCENT="#e0851e"
#  BRAND_COLOR_HIGHLIGHT="#f5b841"

# Indexation : false = site tenu hors des moteurs de recherche ET des robots d'IA
# (noindex + X-Robots-Tag + robots.txt bloquant). Passer a true le jour du lancement.
SITE_INDEXABLE=false

# Instance de demonstration (presentation prospects) : true = bandeau « Demonstration »
# + commande app:demo-reset autorisee. Toujours false sur une instance reelle.
DEMO_MODE=false

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de donnees (MariaDB LWS, utf8mb4 impose) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# A COMPLETER : base, utilisateur et mot de passe MySQL LWS (sans espaces).
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Sessions / files / cache : tout en driver database (pas de Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Sauvegardes (spatie/laravel-backup) ---
# Dossier de mysqldump sur LWS (souvent /usr/bin). `which mysqldump` pour confirmer.
DB_DUMP_BINARY_PATH=/usr/bin
BACKUP_DISK=backups
BACKUP_NOTIFICATION_EMAIL=admin@opti-leads.com

# --- Notification d'erreur admin (active des que APP_DEBUG=false) ---
ERROR_NOTIFICATIONS_ENABLED=true
ADMIN_ERROR_EMAIL=admin@opti-leads.com
ERROR_NOTIFICATIONS_THROTTLE=30

# --- Disques de stockage ---
FILESYSTEM_DISK=local
MEDIA_DISK=public
COURSE_ASSETS_DISK=private
CERTIFICATES_DISK=private

# --- E-mail : Brevo SMTP (PRET) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# A COMPLETER : login et cle SMTP Brevo.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@opti-leads.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Paiement (mode Commercial) ---
# « offline » : confirmation manuelle par l'admin (Wave/Orange Money/virement/especes).
# Un prestataire en ligne se branchera plus tard via une implementation de PaymentGateway.
PAYMENT_GATEWAY=offline

# --- Hebergement video ---
# PALIER 1 : « local » = fichiers MP4 deposes par FTP dans storage/app/videos.
# PALIER 2 : passer a « bunny » et renseigner le bloc Bunny ci-dessous. Aucune lecon
# n'est a recreer : seul ce reglage change.
VIDEO_DRIVER=local
VIDEO_DISK=videos
VIDEO_SIGNED_URL_TTL=14400
# « php » = Laravel streame (compatible partout). « sendfile » = delegue au serveur web,
# bien plus econome, a tester sur LWS avec VIDEO_SENDFILE_HEADER=X-LiteSpeed-Location.
VIDEO_DELIVERY=php
VIDEO_SENDFILE_HEADER=X-LiteSpeed-Location

# --- Bunny Stream : PALIER 2 (laisser vide au lancement) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_SECURITY_KEY=
BUNNY_SIGNED_URL_TTL=14400

# --- Regles metier ---
ACCESS_CODE_MAX_ATTEMPTS=5
ACCESS_CODE_DECAY_MINUTES=60
CERTIFICATE_SERIAL_PREFIX=OPT
# A COMPLETER (optionnel) : numero international sans +, ex. 221771234567
CONTACT_WHATSAPP_NUMBER=

VITE_APP_NAME="${APP_NAME}"
